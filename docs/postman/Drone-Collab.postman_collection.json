{
  "info": {
    "name": "Drone Collab API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Register Pilot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"pilot1\",\n  \"password\": \"pilot123\",\n  \"role\": \"PILOT\",\n  \"displayName\": \"测试飞手\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "List Pilots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/pilots?page=1&size=10"
          }
        },
        {
          "name": "Stats Dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/stats/dashboard"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Pending Pilots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/review/pilots/pending?page=1&size=10"
          }
        },
        {
          "name": "Review Config GET",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/review-config"
          }
        },
        {
          "name": "Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/admin/audit-logs?page=1&size=20"
          }
        }
      ]
    }
  ]
}
